{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/2024.html", "destination": "/anteriores/2024/", "permanent": true },
    { "source": "/2025.html", "destination": "/anteriores/2025/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/agenda.html", "destination": "/agenda/", "permanent": true },
    { "source": "/payment-info.html", "destination": "/payment-info/", "permanent": true }
  ]
}
