---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import StatsBar from '@components/StatsBar.astro';
import SectionTitle from '@components/SectionTitle.astro';
import OrganizerCard from '@components/OrganizerCard.astro';
import SponsorTier from '@components/SponsorTier.astro';
import SponsorPackages from '@components/SponsorPackages.astro';
import GalleryCarousel from '@components/GalleryCarousel.astro';
import { getCollection } from 'astro:content';
import { getFeaturedEdition } from '@lib/editions';
import { CONTACT_EMAILS, SITE, SOCIAL } from '@lib/site';

const edition = await getFeaturedEdition();

const allOrganizers = await getCollection('organizers');
const organizersForEdition = allOrganizers
  .filter((o) => o.data.editions.includes(edition.data.year))
  .sort((a, b) => a.data.order - b.data.order);

const allSponsors = await getCollection('sponsors');
const sponsorsForEdition = allSponsors.filter((s) =>
  s.data.editions.includes(edition.data.year),
);
const platinum = sponsorsForEdition.filter((s) => s.data.tier === 'platinum');
const gold = sponsorsForEdition.filter((s) => s.data.tier === 'gold');
const silver = sponsorsForEdition.filter((s) => s.data.tier === 'silver');

const addressParts = (edition.data.venue.address ?? '').split(',').map((part) => part.trim());
const street = addressParts[0];
const district = addressParts.slice(1).join(', ');
const directionLine = [
  street,
  edition.data.venue.name,
  district
    ? `${district}, ${edition.data.venue.city}-${edition.data.venue.country}.`
    : `${edition.data.venue.city}-${edition.data.venue.country}.`,
]
  .filter(Boolean)
  .join(' · ');

const aboutDate =
  edition.data.date != null
    ? new Intl.DateTimeFormat('es-PE', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      }).format(edition.data.date)
    : (edition.data.dateLabel ?? 'fecha por anunciar');

// JSON-LD del evento.
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: edition.data.title,
  description: edition.data.tagline,
  eventStatus:
    edition.data.status === 'upcoming'
      ? 'https://schema.org/EventScheduled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode: edition.data.venue.online
    ? 'https://schema.org/OnlineEventAttendanceMode'
    : 'https://schema.org/OfflineEventAttendanceMode',
  ...(edition.data.date && { startDate: edition.data.date.toISOString() }),
  location: edition.data.venue.online
    ? {
        '@type': 'VirtualLocation',
        url: 'https://jconfperu.com',
      }
    : {
        '@type': 'Place',
        name: edition.data.venue.name,
        address: {
          '@type': 'PostalAddress',
          streetAddress: edition.data.venue.address,
          addressLocality: edition.data.venue.city,
          addressCountry: edition.data.venue.country,
        },
      },
  organizer: {
    '@type': 'Organization',
    name: 'Peru JUG',
    url: 'https://perujug.org/',
  },
};
---

<Layout
  title={edition.data.title}
  description={`${edition.data.title}: ${edition.data.tagline} Organizada por Peru JUG.`}
  jsonLd={eventJsonLd}
>
  <Hero edition={edition} />

  <section id="about" class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <SectionTitle title="Acerca de" highlight="JCONF" />
      <p class="text-center max-w-3xl mx-auto text-base sm:text-lg leading-relaxed" style="color: var(--fg-base);">
        <strong>{edition.data.title}</strong> será un Full Day presencial el <strong>{aboutDate}</strong>{edition.data.dateLabel && <>, de <strong>{edition.data.dateLabel}</strong></>}.
        Busca conectar a desarrolladores y empresas interesadas en las tecnologías alrededor de Java.
        Contaremos con <strong>expositores de diferentes partes del mundo</strong> que compartirán con nosotros
        los paradigmas y tecnologías que actualmente están marcando la pauta en el mercado y lo que se viene a
        futuro con respecto a Java, Jakarta EE, Spring, GraalVM, Microprofile, Cloud Computing, arquitecturas
        nativas en la nube, Contenedores, DevOps, Inteligencia Artificial, etc.
      </p>
      <StatsBar stats={edition.data.stats} />
    </div>
    <GalleryCarousel />
  </section>

  {
    organizersForEdition.length > 0 && (
      <section
        id="organizers"
        class="border-t bg-andean-pattern py-16"
        style="border-color: var(--border-subtle);"
      >
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <SectionTitle eyebrow="Quiénes hacemos esto posible" title="Organizadores" />
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {organizersForEdition.map((o) => (
              <OrganizerCard organizer={o} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section
    id="speakers"
    class="border-t py-16 max-w-6xl mx-auto px-4 sm:px-6"
    style="border-color: var(--border-subtle);"
  >
    <SectionTitle eyebrow="Conferencistas" title="Nuestros" highlight="speakers" />
    {
      edition.data.status === 'upcoming' ? (
        <div class="text-center max-w-xl mx-auto">
          <p class="text-lg" style="color: var(--fg-muted);">
            <span class="text-2xl">🎤</span>{' '}
            <strong>Speakers por anunciar.</strong>
          </p>
          <p class="mt-3" style="color: var(--fg-muted);">
            Estamos preparando un line-up internacional. Si quieres exponer en JConf Perú {edition.data.year},
            sigue a Peru JUG en redes para enterarte cuando abra el Call for Papers.
          </p>
        </div>
      ) : (
        <p class="text-center" style="color: var(--fg-muted);">
          Revisa el listado completo en{' '}
          <a class="underline text-brand-red" href="/speakers">
            /speakers
          </a>
          .
        </p>
      )
    }
  </section>

  <section
    id="sponsors"
    class="border-t py-16"
    style="border-color: var(--border-subtle);"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionTitle title="Se" highlight="Sponsor" />
      <SponsorPackages />
      {
        sponsorsForEdition.length > 0 && (
          <div class="grid gap-10 mt-16">
            <SponsorTier tier="platinum" sponsors={platinum} />
            <SponsorTier tier="gold" sponsors={gold} />
            <SponsorTier tier="silver" sponsors={silver} />
          </div>
        )
      }
    </div>
  </section>

  <section id="contact" class="border-t py-16" style="border-color: var(--border-subtle);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionTitle title="Informacion de" highlight="Contacto" />
      <div class="grid gap-12 sm:grid-cols-3 text-center">
        <div>
          <h3 class="contact-heading text-xl">Dirección</h3>
          <p style="color: var(--fg-base);">{directionLine}</p>
        </div>
        <div class="grid gap-10 content-start">
          <div>
            <h3 class="contact-heading text-xl">Website</h3>
            <a class="contact-link" href={SITE.organizationUrl} target="_blank" rel="noopener noreferrer">
              PeruJUG website
            </a>
          </div>
          <div>
            <h3 class="contact-heading text-xl">MeetUp</h3>
            <a class="contact-link" href={SOCIAL.meetup} target="_blank" rel="noopener noreferrer">
              PeruJUG meetup
            </a>
          </div>
        </div>
        <div class="grid gap-10 content-start">
          <div>
            <h3 class="contact-heading text-xl">Whatsapp</h3>
            <a class="contact-link" href={SOCIAL.whatsapp} target="_blank" rel="noopener noreferrer">
              PeruJUG Whatsapp
            </a>
          </div>
          <div>
            <h3 class="contact-heading text-xl">Contacto para Sponsor</h3>
            <ul class="grid gap-1">
              {
                CONTACT_EMAILS.map((contact) => (
                  <li>
                    <a class="contact-link" href={`mailto:${contact.email}`}>
                      {contact.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
