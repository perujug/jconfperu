---
import Layout from '@layouts/Layout.astro';
import SectionTitle from '@components/SectionTitle.astro';
import PartnerLogos from '@components/PartnerLogos.astro';
import { getCollection } from 'astro:content';
import { getFeaturedEdition } from '@lib/editions';

const edition = await getFeaturedEdition();
const communities = (await getCollection('alliedCommunities'))
  .filter((community) => community.data.editions.includes(edition.data.year))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`Comunidades aliadas · ${edition.data.title}`}
  description={`Comunidades aliadas de ${edition.data.title}.`}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <SectionTitle eyebrow={edition.data.title} title="Comunidades" highlight="aliadas" />
    {
      communities.length > 0 ? (
        <PartnerLogos partners={communities} />
      ) : (
        <p class="text-center" style="color: var(--fg-muted);">
          Pronto anunciaremos las comunidades aliadas de {edition.data.title}.
        </p>
      )
    }
  </section>
</Layout>
