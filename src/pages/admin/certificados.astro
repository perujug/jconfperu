<script>
  import { rosterWindow } from '@lib/certificates/pages';

  const search = document.getElementById('roster-search');
  const status = document.getElementById('roster-status');
  const table = document.getElementById('roster');
  const empty = document.getElementById('roster-empty');
  const pagers = [...document.querySelectorAll('[data-roster-pager]')];
  if (search instanceof HTMLInputElement && status instanceof HTMLSelectElement && table && empty) {
    const rows = [...table.querySelectorAll('tbody tr')];
    const fold = (value: string) => value.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
    let page = Number(new URL(window.location.href).searchParams.get('pagina')) || 1;

    const remember = () => {
      table.querySelectorAll('form').forEach((form) => {
        let field = form.querySelector('input[name="pagina"]');
        if (!(field instanceof HTMLInputElement)) {
          field = document.createElement('input');
          field.type = 'hidden';
          field.name = 'pagina';
          form.append(field);
        }
        field.value = page > 1 ? String(page) : '';
      });
    };

    const paint = (total: number) => {
      const windowed = rosterWindow(total, page);
      page = windowed.page;
      for (const pager of pagers) {
        pager.hidden = total === 0;
        pager.replaceChildren();
        if (total === 0) continue;
        const range = document.createElement('p');
        range.textContent = `${windowed.start}–${windowed.end} de ${total}`;
        pager.append(range);
        if (windowed.pages < 2) continue;
        const controls = document.createElement('div');
        const previous = document.createElement('button');
        previous.type = 'button';
        previous.textContent = 'Anterior';
        previous.disabled = windowed.page <= 1;
        previous.addEventListener('click', () => go(windowed.page - 1));
        controls.append(previous);
        for (let index = 1; index <= windowed.pages; index += 1) {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(index);
          if (index === windowed.page) button.setAttribute('aria-current', 'page');
          button.addEventListener('click', () => go(index));
          controls.append(button);
        }
        const next = document.createElement('button');
        next.type = 'button';
        next.textContent = 'Siguiente';
        next.disabled = windowed.page >= windowed.pages;
        next.addEventListener('click', () => go(windowed.page + 1));
        controls.append(next);
        pager.append(controls);
      }
    };

    const apply = (fromClick = false) => {
      const terms = fold(search.value).split(/\s+/).filter(Boolean);
      const state = status.value;
      const matches: HTMLTableRowElement[] = [];
      for (const row of rows) {
        if (!(row instanceof HTMLTableRowElement)) continue;
        const hay = fold(row.getAttribute('data-search') || '');
        const textMatch = terms.every((term) => hay.includes(term));
        const stateMatch = state === '' || row.getAttribute('data-status') === state;
        const match = textMatch && stateMatch;
        row.hidden = !match;
        if (match) matches.push(row);
      }
      const windowed = rosterWindow(matches.length, page);
      page = windowed.page;
      matches.forEach((row, index) => {
        const visible = index >= windowed.start - 1 && index < windowed.end;
        row.hidden = !visible;
      });
      table.classList.remove('pending');
      empty.hidden = matches.length !== 0;
      paint(matches.length);
      document.querySelectorAll('input[name="q"]').forEach((field) => {
        if (field instanceof HTMLInputElement && field !== search) field.value = search.value;
      });
      document.querySelectorAll('input[name="estado"]').forEach((field) => {
        if (field instanceof HTMLInputElement) field.value = state;
      });
      remember();
      const url = new URL(window.location.href);
      if (search.value.trim()) url.searchParams.set('q', search.value.trim());
      else url.searchParams.delete('q');
      if (state === 'paid' || state === 'unpaid') url.searchParams.set('estado', state);
      else url.searchParams.delete('estado');
      if (page > 1) url.searchParams.set('pagina', String(page));
      else url.searchParams.delete('pagina');
      history.replaceState(null, '', url);
      if (fromClick) table.scrollIntoView({ block: 'start' });
    };

    const go = (next: number) => {
      page = next;
      apply(true);
    };

    search.addEventListener('input', () => {
      page = 1;
      apply();
    });
    status.addEventListener('change', () => {
      page = 1;
      apply();
    });
    apply();
  }
</script>
