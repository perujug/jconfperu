---
export const prerender = false;

import Layout from '@layouts/Layout.astro';
import { resolveGithubAccount } from '@lib/auth/github';
import { deleteTempCookie, readSession, setTempCookie } from '@lib/auth/session';
import { rosterWorkbook } from '@lib/certificates/excel';
import { parseRole, ROLES } from '@lib/certificates/roles';
import { editionFacts } from '@lib/certificates/snapshot';
import { normalizePhone, paymentStatus } from '@lib/certificates/registration';
import {
  addAdmin,
  addManualAttendee,
  ensureRegistrationToken,
  importAttendees,
  isAdmin,
  listAdmins,
  listAttendees,
  removeAdmin,
  rotateRegistrationToken,
  seedAdmins,
  setOnlineCode,
  setPaymentStatus,
  setRosterKind,
  setRevoked,
  setYearOpen,
  updateAttendeeEmail,
  unlinkGithub,
  yearAccess,
  yearIsOpen,
} from '@lib/certificates/store';
import { whatsAppLink } from '@lib/certificates/whatsapp';
import QRCode from 'qrcode';
import { authConfigured, bootstrapAdminIds } from '@lib/config';
import { publicUrl } from '@lib/site';
import { getAllEditions } from '@lib/editions';
import type { CsvIssue } from '@lib/certificates/csv';

const views = ['resumen', 'lista', 'carga', 'organizadores'] as const;
type AdminView = (typeof views)[number];

const session = await readSession(Astro.cookies);
const editions = await getAllEditions();
const requested = Number(Astro.url.searchParams.get('year'));
const selected = editions.find((edition) => edition.data.year === requested) ?? editions[0];
const year = selected?.data.year ?? null;
const requestedView = Astro.url.searchParams.get('vista');
const view: AdminView = views.includes(requestedView as AdminView) ? (requestedView as AdminView) : 'resumen';

function adminPath(nextYear = year, nextView: AdminView = view, notice?: string, q?: string, estado?: string, pagina?: string) {
  const params = new URLSearchParams();
  if (nextYear) params.set('year', String(nextYear));
  if (nextView !== 'resumen') params.set('vista', nextView);
  if (notice) params.set('aviso', notice);
  if (q?.trim()) params.set('q', q.trim());
  if (estado === 'paid' || estado === 'unpaid') params.set('estado', estado);
  const page = Number(pagina);
  if (Number.isInteger(page) && page > 1) params.set('pagina', String(page));
  const query = params.toString();
  return `/admin/certificados/${query ? `?${query}` : ''}`;
}

let allowed = false;
let dbError = false;
if (session) {
  try {
    await seedAdmins();
    allowed = await isAdmin(session.githubId);
  } catch {
    dbError = true;
  }
}

if (Astro.request.method === 'POST' && session && allowed && year && !dbError) {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const listBack = (notice?: string) =>
    adminPath(year, 'lista', notice, String(form.get('q') ?? ''), String(form.get('estado') ?? ''), String(form.get('pagina') ?? ''));
  try {
    if (intent === 'toggle') {
      await setYearOpen(year, form.get('open') === '1');
      return Astro.redirect(adminPath(year, 'resumen'));
    }
    if (intent === 'import') {
      const file = form.get('csv');
      const text = file instanceof File ? await file.text() : '';
      const result = await importAttendees(year, text);
      setTempCookie(
        Astro.cookies,
        'jconf_import',
        encodeURIComponent(JSON.stringify({ added: result.added, updated: result.updated, unchanged: result.unchanged, errors: result.errors.slice(0, 20) })),
        120,
      );
      return Astro.redirect(adminPath(year, 'carga'));
    }
    if (intent === 'add-person') {
      const githubField = String(form.get('github') ?? '');
      const account = githubField.trim() ? await resolveGithubAccount(githubField) : null;
      if (githubField.trim() && !account) return Astro.redirect(adminPath(year, 'carga', 'github'));
      const role = parseRole(String(form.get('rol') ?? ''));
      const phoneRaw = String(form.get('phone') ?? '');
      const phone = phoneRaw.trim() ? normalizePhone(phoneRaw) : null;
      if (phoneRaw.trim() && !phone) return Astro.redirect(adminPath(year, 'carga', 'phone'));
      const outcome = await addManualAttendee({
        year,
        email: String(form.get('email') ?? ''),
        suggestedName: String(form.get('nombre') ?? ''),
        role: role ?? 'participante',
        githubId: account?.githubId ?? null,
        githubLogin: account?.login ?? null,
        phone,
      });
      return Astro.redirect(adminPath(year, 'carga', outcome));
    }
    if (intent === 'revoke') {
      await setRevoked(String(form.get('id') ?? ''), form.get('revoked') === '1');
      return Astro.redirect(listBack());
    }
    if (intent === 'unlink') {
      await unlinkGithub(String(form.get('id') ?? ''));
      return Astro.redirect(listBack());
    }
    if (intent === 'kind') {
      const kind = String(form.get('kind') ?? '');
      if (kind !== 'paid' && kind !== 'speaker' && kind !== 'organizer' && kind !== 'volunteer') return Astro.redirect(listBack('error'));
      const source = editions.find((item) => item.data.year === year);
      const facts = source
        ? editionFacts({
            title: source.data.title,
            tagline: source.data.tagline,
            date: source.data.date,
            dateLabel: source.data.dateLabel,
            venue: source.data.venue,
          })
        : null;
      await setRosterKind(String(form.get('id') ?? ''), kind, facts);
      return Astro.redirect(listBack());
    }
    if (intent === 'add-admin') {
      const account = await resolveGithubAccount(String(form.get('github') ?? ''));
      if (!account) return Astro.redirect(adminPath(year, 'organizadores', 'github'));
      await addAdmin(account.githubId, String(form.get('label') ?? '').trim() || account.login, account.login);
      return Astro.redirect(adminPath(year, 'organizadores'));
    }
    if (intent === 'remove-admin') {
      await removeAdmin(Number(form.get('githubId')));
      return Astro.redirect(adminPath(year, 'organizadores'));
    }
    if (intent === 'rotate-link') {
      await rotateRegistrationToken(year);
      return Astro.redirect(adminPath(year, 'resumen'));
    }
    if (intent === 'online-code') {
      await setOnlineCode(year, String(form.get('code') ?? ''));
      return Astro.redirect(adminPath(year, 'resumen'));
    }
    if (intent === 'payment') {
      await setPaymentStatus(String(form.get('id') ?? ''), form.get('status') === 'paid' ? 'paid' : 'unpaid');
      return Astro.redirect(listBack());
    }
    if (intent === 'email') {
      const outcome = await updateAttendeeEmail(String(form.get('id') ?? ''), String(form.get('email') ?? ''));
      const notice = outcome === 'updated' ? 'email-updated' : outcome === 'taken' ? 'email-taken' : 'email-invalid';
      return Astro.redirect(listBack(notice));
    }
  } catch {
    return Astro.redirect(adminPath(year, view, 'error'));
  }
}

let open = false;
let registrationToken: string | null = null;
let onlineCode = '';
let people: Awaited<ReturnType<typeof listAttendees>> = [];
let organizers: Array<{ githubId: number; label: string; login: string | null }> = [];
let imported: { added: number; updated: number; unchanged: number; errors: CsvIssue[] } | null = null;

if (session && allowed && year && !dbError) {
  try {
    open = await yearIsOpen(year);
    registrationToken = await ensureRegistrationToken(year);
    onlineCode = (await yearAccess(year)).onlineCode ?? '';
    people = (await listAttendees(year)).sort((a, b) => (a.suggestedName || a.email || '').localeCompare(b.suggestedName || b.email || '', 'es'));
    organizers = await listAdmins({ githubId: session.githubId, login: session.login });
    const raw = Astro.cookies.get('jconf_import')?.value;
    if (raw) {
      deleteTempCookie(Astro.cookies, 'jconf_import');
      imported = JSON.parse(decodeURIComponent(raw)) as { added: number; updated: number; unchanged: number; errors: CsvIssue[] };
    }
  } catch {
    dbError = true;
  }
}

const counts = {
  total: people.length,
  unpaid: people.filter((person) => !person.revokedAt && paymentStatus(person.paymentStatus) === 'unpaid').length,
  paid: people.filter((person) => !person.revokedAt && paymentStatus(person.paymentStatus) === 'paid').length,
  online: people.filter((person) => !person.revokedAt && paymentStatus(person.paymentStatus) === 'online').length,
};
const registerUrl = registrationToken
  ? publicUrl(`/certificado/${year}/registro/?clave=${registrationToken}`, Astro.url.origin)
  : '';
const accountUrl = publicUrl('/mi/', Astro.url.origin);
const registerQr = registerUrl ? await QRCode.toDataURL(registerUrl, { margin: 1, width: 220 }) : '';
const nav = [
  ['resumen', 'Resumen'],
  ['lista', 'Lista'],
  ['carga', 'Carga'],
  ['organizadores', 'Organizadores'],
] as const;

const aviso = Astro.url.searchParams.get('aviso');
const exportScope = Astro.url.searchParams.get('exportar');
if (
  Astro.request.method === 'GET' &&
  session &&
  allowed &&
  year &&
  !dbError &&
  (exportScope === 'todos' || exportScope === 'paid' || exportScope === 'unpaid')
) {
  const workbook = rosterWorkbook(people, exportScope);
  return new Response(workbook, {
    headers: {
      'Content-Type': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
      'Content-Disposition': `attachment; filename="jconf-peru-${year}-${exportScope}.xlsx"`,
      'Cache-Control': 'no-store',
    },
  });
}

const rosterQuery = Astro.url.searchParams.get('q') ?? '';
const requestedStatus = Astro.url.searchParams.get('estado');
const rosterStatus = requestedStatus === 'paid' || requestedStatus === 'unpaid' ? requestedStatus : '';
const protectedIds = new Set(bootstrapAdminIds());
const notices: Record<string, string> = {
  added: 'Persona agregada a la lista.',
  updated: 'Persona actualizada. El certificado ya expedido no cambia.',
  taken: 'Ese GitHub ya está vinculado a otra entrada de este año.',
  invalid: 'Revisa el correo y el nombre.',
  'email-updated': 'Correo actualizado. Con ese correo el GitHub podrá encontrar a la persona.',
  'email-taken': 'Ese correo ya pertenece a otra persona de este año.',
  'email-invalid': 'Revisa el correo. Tiene que ser una dirección válida.',
  github: 'No encontramos esa cuenta de GitHub.',
  phone: 'Revisa el celular. Puedes dejarlo vacío.',
  error: 'No pudimos guardar el cambio.',
};
---

<Layout admin title="Certificados" description="Administración de certificados de JConf Perú." noindex>
  <div class="shell">
    <header class="top">
      <div class="brand">
        <a href="/">JConf Perú</a>
        <span>Admin</span>
      </div>
      {
        session && allowed && !dbError && (
          <nav aria-label="Secciones">
            {
              nav.map(([id, label]) => (
                <a href={adminPath(year, id)} aria-current={view === id ? 'page' : undefined}>{label}</a>
              ))
            }
          </nav>
        )
      }
      <div class="account">
        <a href="/">Ver sitio</a>
        {session && <span>@{session.login}</span>}
        {
          session && (
            <form method="post" action="/auth/github/logout">
              <button type="submit">Salir</button>
            </form>
          )
        }
      </div>
    </header>

    <div class="content">

      {aviso && notices[aviso] && <p class="notice" role="alert">{notices[aviso]}</p>}
      {dbError && <p class="notice" role="alert">La base de certificados no está disponible. Revisa DATABASE_URL.</p>}

      {
        !session && (
          <section class="card narrow">
            <h1>Certificados</h1>
            <p>Entra con la cuenta de GitHub que administra JConf Perú.</p>
            {
              authConfigured() ? (
                <a class="btn" href="/auth/github/login/?next=/admin/certificados/">Entrar con GitHub</a>
              ) : (
                <p>El ingreso con GitHub todavía no está configurado.</p>
              )
            }
          </section>
        )
      }
      {session && !allowed && !dbError && <p class="notice">Tu cuenta de GitHub no administra los certificados.</p>}

      {
        session && allowed && !dbError && selected && year && (
          <>
            <div class="heading">
              <div>
                <h1>Certificados</h1>
                <p>JConf Perú {year} está {open ? 'abierto' : 'cerrado'}.</p>
              </div>
              <form method="get" class="year">
                {view !== 'resumen' && <input type="hidden" name="vista" value={view} />}
                <label>
                  Año
                  <select name="year" onchange="this.form.requestSubmit()">
                    {editions.map((edition) => (
                      <option value={edition.data.year} selected={edition.data.year === year}>{edition.data.year}</option>
                    ))}
                  </select>
                </label>
              </form>
            </div>

            {
              view === 'resumen' && (
                <>
                  <div class="stats">
                    <article class="card"><p>Registrados</p><strong>{counts.total}</strong></article>
                    <article class="card"><p>UNPAID</p><strong>{counts.unpaid}</strong></article>
                    <article class="card"><p>PAID</p><strong>{counts.paid}</strong></article>
                    <article class="card"><p>ONLINE</p><strong>{counts.online}</strong></article>
                  </div>
                  <div class="split">
                    <section class="card">
                      <h2>Enlace de registro</h2>
                      <p>Compártelo o muestra el QR. Quien entre anota su nombre. El certificado sale solo si lo marcas PAID o si escribe el código de la charla.</p>
                      <p>Después del evento, el participante entra a <a href={accountUrl}>{accountUrl}</a> con la misma cuenta de GitHub y descarga desde ahí.</p>
                      {registerQr && <img class="qr" src={registerQr} alt="QR del registro de certificados" width="160" height="160" />}
                      <p class="example">{registerUrl}</p>
                      <form method="post">
                        <input type="hidden" name="intent" value="rotate-link" />
                        <button class="btn" type="submit">Generar otro enlace</button>
                      </form>
                    </section>
                    <form method="post" class="card">
                      <h2>Código de las charlas online</h2>
                      <p>Dilo en las charlas. Quien lo escriba pasa a ONLINE y puede descargar sin haber pagado. Si lo cambias, el anterior deja de servir.</p>
                      <input type="hidden" name="intent" value="online-code" />
                      <label>
                        Código
                        <input name="code" value={onlineCode} autocomplete="off" />
                      </label>
                      <button class="btn" type="submit">Guardar código</button>
                    </form>
                  </div>
                  <div class="actions">
                    <a class="card link" href={adminPath(year, 'lista')}>
                      <strong>Lista</strong>
                      <span>Correos, roles, vínculo con GitHub y revocaciones.</span>
                    </a>
                    <a class="card link" href={adminPath(year, 'carga')}>
                      <strong>Cargar personas</strong>
                      <span>CSV de pagos o un alta manual desde WhatsApp.</span>
                    </a>
                    <a class="card link" href={adminPath(year, 'organizadores')}>
                      <strong>Organizadores</strong>
                      <span>Quién puede entrar a este panel.</span>
                    </a>
                    <form method="post" class="card status">
                      <input type="hidden" name="intent" value="toggle" />
                      <input type="hidden" name="open" value={open ? '0' : '1'} />
                      <strong>{open ? 'Recepción abierta' : 'Recepción cerrada'}</strong>
                      <span>{open ? 'El enlace acepta registros. El PDF sale con PAID o con el código online.' : 'Nadie nuevo puede registrarse. Los ya validados siguen disponibles.'}</span>
                      <button class="btn" type="submit">{open ? 'Cerrar registros' : 'Abrir registros'}</button>
                    </form>
                  </div>
                </>
              )
            }

            {
              view === 'lista' && (
                <section class="card">
                  <h2>Lista {year}</h2>
                  {
                    people.length === 0 ? (
                      <p>Nadie se ha registrado. Comparte el enlace del resumen.</p>
                    ) : (
                      <>
                        <form class="filters" method="get" action="/admin/certificados/">
                          <input type="hidden" name="year" value={year} />
                          <input type="hidden" name="vista" value="lista" />
                          <label>
                            Buscar
                            <input id="roster-search" type="search" name="q" value={rosterQuery} placeholder="Nombre, apellido, GitHub o correo" autocomplete="off" />
                          </label>
                          <label>
                            Estado
                            <select id="roster-status" name="estado" aria-label="Filtrar por estado">
                              <option value="" selected={rosterStatus === ''}>Todos</option>
                              <option value="paid" selected={rosterStatus === 'paid'}>PAID</option>
                              <option value="unpaid" selected={rosterStatus === 'unpaid'}>UNPAID</option>
                            </select>
                          </label>
                        </form>
                        <div class="exports">
                          <span>Excel</span>
                          <a href={`/admin/certificados/?year=${year}&vista=lista&exportar=todos`}>Todos</a>
                          <a href={`/admin/certificados/?year=${year}&vista=lista&exportar=paid`}>PAID</a>
                          <a href={`/admin/certificados/?year=${year}&vista=lista&exportar=unpaid`}>UNPAID</a>
                        </div>
                        <p id="roster-empty" hidden>Nadie coincide con ese filtro.</p>
                        <p>VOLUNTARIO es quien apoya las transmisiones en línea, el soporte de las charlas, la comida y las bebidas.</p>
                        <nav class="pager" data-roster-pager aria-label="Páginas de la lista" hidden></nav>
                        <div class="table-wrap">
                          <table id="roster" class="pending">
                            <thead>
                              <tr>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>GitHub</th>
                                <th>Celular</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                              </tr>
                            </thead>
                            <tbody>
                              {
                                people.map((person) => {
                                  const pay = person.revokedAt ? 'revocado' : paymentStatus(person.paymentStatus);
                                  const label = pay === 'paid' ? 'PAID' : pay === 'online' ? 'ONLINE' : pay === 'revocado' ? 'Revocado' : 'UNPAID';
                                  const role = parseRole(person.role) ?? 'participante';
                                  const kind = role === 'conferencista' ? 'speaker' : role === 'organizador' ? 'organizer' : role === 'voluntario' ? 'volunteer' : 'paid';
                                  const chat = person.phone
                                    ? whatsAppLink(person.phone, `Hola, te escribimos de JConf Perú ${year} por tu certificado.`)
                                    : null;
                                  const search = [person.displayName, person.suggestedName, person.givenName, person.familyName, person.email, person.githubLogin, person.githubId]
                                    .filter((value) => value != null && String(value).trim())
                                    .join(' ');
                                  return (
                                    <tr data-search={search} data-status={pay}>
                                      <td>{person.displayName || person.suggestedName}</td>
                                      <td>
                                        <form class="email-form" method="post">
                                          <input type="hidden" name="intent" value="email" />
                                          <input type="hidden" name="id" value={person.id} />
                                          <input type="hidden" name="q" value={rosterQuery} />
                                          <input type="hidden" name="estado" value={rosterStatus} />
                                          <input
                                            type="email"
                                            name="email"
                                            value={person.email ?? ''}
                                            required
                                            autocomplete="off"
                                            spellcheck="false"
                                            aria-label={`Correo de ${person.displayName || person.suggestedName}`}
                                          />
                                          <button type="submit">Guardar</button>
                                        </form>
                                      </td>
                                      <td>{person.githubLogin ? `@${person.githubLogin}` : person.githubId ? String(person.githubId) : '—'}</td>
                                      <td>{chat ? <a href={chat} target="_blank" rel="noopener noreferrer">{person.phone}</a> : '—'}</td>
                                      <td>
                                        <form class="kind-form" method="post">
                                          <input type="hidden" name="intent" value="kind" />
                                          <input type="hidden" name="id" value={person.id} />
                                          <input type="hidden" name="q" value={rosterQuery} />
                                          <input type="hidden" name="estado" value={rosterStatus} />
                                          <select name="kind" aria-label={`Rol de ${person.displayName || person.suggestedName}`} onchange="this.form.requestSubmit()">
                                            <option value="paid" selected={kind === 'paid'}>PARTICIPANTE</option>
                                            <option value="speaker" selected={kind === 'speaker'}>SPEAKER</option>
                                            <option value="organizer" selected={kind === 'organizer'}>ORGANIZER</option>
                                            <option value="volunteer" selected={kind === 'volunteer'}>VOLUNTARIO</option>
                                          </select>
                                        </form>
                                      </td>
                                      <td><span class={`state ${pay}`}>{label}</span></td>
                                      <td>
                                        <div class="actions-cell">
                                          {
                                            !person.revokedAt && pay !== 'online' && (
                                              <form method="post">
                                                <input type="hidden" name="intent" value="payment" />
                                                <input type="hidden" name="id" value={person.id} />
                                                <input type="hidden" name="q" value={rosterQuery} />
                                          <input type="hidden" name="estado" value={rosterStatus} />
                                                <input type="hidden" name="status" value={pay === 'paid' ? 'unpaid' : 'paid'} />
                                                <button type="submit">{pay === 'paid' ? 'Volver a impago' : 'Marcar pagado'}</button>
                                              </form>
                                            )
                                          }
                                          <form method="post">
                                            <input type="hidden" name="intent" value="revoke" />
                                            <input type="hidden" name="id" value={person.id} />
                                            <input type="hidden" name="q" value={rosterQuery} />
                                          <input type="hidden" name="estado" value={rosterStatus} />
                                            <input type="hidden" name="revoked" value={person.revokedAt ? '0' : '1'} />
                                            <button type="submit">{person.revokedAt ? 'Restaurar' : 'Revocar'}</button>
                                          </form>
                                          {
                                            person.githubId && !person.issuedAt && (
                                              <form method="post">
                                                <input type="hidden" name="intent" value="unlink" />
                                                <input type="hidden" name="id" value={person.id} />
                                                <input type="hidden" name="q" value={rosterQuery} />
                                          <input type="hidden" name="estado" value={rosterStatus} />
                                                <button type="submit">Desvincular</button>
                                              </form>
                                            )
                                          }
                                        </div>
                                      </td>
                                    </tr>
                                  );
                                })
                              }
                            </tbody>
                          </table>
                        </div>
                        <nav class="pager" data-roster-pager aria-label="Páginas de la lista" hidden></nav>
                      </>
                    )
                  }
                </section>
              )
            }

            {
              view === 'carga' && (
                <div class="split">
                  <form method="post" enctype="multipart/form-data" class="card">
                    <h2>CSV de pagos</h2>
                    <p>Una fila por persona. El correo es la clave: si vuelves a cargar el archivo con los últimos pagos, ese correo se actualiza y no se crea otra fila. Quien ya no venga en el archivo se queda. Un certificado ya expedido no se reescribe.</p>
                    <pre class="example">email,nombre,rol
ana.perez@correo.com,Ana Pérez,participante
beto.quispe@correo.com,Beto Quispe,conferencista
luz.mendoza@correo.com,Luz Mendoza,organizador
rosa.vega@correo.com,Rosa Vega,voluntario</pre>
                    <p>El rol puede omitirse y queda como participante. También valen speaker, organizer y voluntario. Voluntario es quien apoya las transmisiones en línea, el soporte de las charlas, la comida y las bebidas. El certificado se descarga con el pago confirmado, o si el rol es speaker, organizer o voluntario.</p>
                    <input type="hidden" name="intent" value="import" />
                    <input type="file" name="csv" accept=".csv,text/csv" required />
                    <button class="btn" type="submit">Cargar CSV</button>
                    {
                      imported && (
                        <p role="status">
                          {imported.added} nuevos, {imported.updated} actualizados, {imported.unchanged ?? 0} ya estaban
                          {imported.errors.length > 0 ? `, ${imported.errors.length} observaciones.` : '.'}
                        </p>
                      )
                    }
                    {imported?.errors.map((error) => <p class="error">Línea {error.line}: {error.message}</p>)}
                  </form>

                  <form method="post" class="card">
                    <h2>Alta manual</h2>
                    <p>Para quien escribió por WhatsApp y no venía en el archivo.</p>
                    <input type="hidden" name="intent" value="add-person" />
                    <label>Correo<input type="email" name="email" required /></label>
                    <label>Nombre de referencia<input name="nombre" required /></label>
                    <label>
                      Rol
                      <select name="rol">
                        {ROLES.map((role) => <option value={role}>{role}</option>)}
                      </select>
                    </label>
                    <label>Celular<input name="phone" placeholder="Opcional" autocomplete="tel" /></label>
                    <label>GitHub, usuario o id<input name="github" placeholder="Opcional" /></label>
                    <button class="btn" type="submit">Agregar a {year}</button>
                  </form>
                </div>
              )
            }

            {
              view === 'organizadores' && (
                <div class="split">
                  <section class="card">
                    <h2>Con acceso</h2>
                    <ul class="people">
                      {
                        organizers.map((organizer) => (
                          <li>
                            <span>
                              {organizer.login ? `@${organizer.login}` : organizer.label}
                              {organizer.login && organizer.label !== organizer.login && <small>{organizer.label}</small>}
                            </span>
                            {
                              protectedIds.has(organizer.githubId) ? (
                                <em>Fijo</em>
                              ) : (
                                <form method="post">
                                  <input type="hidden" name="intent" value="remove-admin" />
                                  <input type="hidden" name="githubId" value={organizer.githubId} />
                                  <button type="submit">Quitar</button>
                                </form>
                              )
                            }
                          </li>
                        ))
                      }
                    </ul>
                  </section>
                  <form method="post" class="card">
                    <h2>Agregar organizador</h2>
                    <p>Puede entrar a este panel sin un nuevo deploy.</p>
                    <input type="hidden" name="intent" value="add-admin" />
                    <label>GitHub, usuario o id<input name="github" required /></label>
                    <label>Nombre<input name="label" /></label>
                    <button class="btn" type="submit">Agregar</button>
                  </form>
                </div>
              )
            }
          </>
        )
      }
    </div>
  </div>
</Layout>

