---
import Layout from '@layouts/Layout.astro';
import SectionTitle from '@components/SectionTitle.astro';
import SponsorTier from '@components/SponsorTier.astro';
import SponsorPackages from '@components/SponsorPackages.astro';
import { getCollection } from 'astro:content';
import { getFeaturedEdition } from '@lib/editions';

const edition = await getFeaturedEdition();
const allSponsors = await getCollection('sponsors');
const current = allSponsors.filter((s) => s.data.editions.includes(edition.data.year));
const platinum = current.filter((s) => s.data.tier === 'platinum');
const gold = current.filter((s) => s.data.tier === 'gold');
const silver = current.filter((s) => s.data.tier === 'silver');
const community = current.filter((s) => s.data.tier === 'community');
---

<Layout
  title={`Sponsors · ${edition.data.title}`}
  description={`Patrocinadores oficiales de ${edition.data.title}. Conoce los paquetes Platinum, Gold y Silver.`}
>
  {
    current.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
        <SectionTitle eyebrow={edition.data.title} title="Nuestros" highlight="sponsors" />
        <div class="grid gap-12">
          <SponsorTier tier="platinum" sponsors={platinum} />
          <SponsorTier tier="gold" sponsors={gold} />
          <SponsorTier tier="silver" sponsors={silver} />
          <SponsorTier tier="community" sponsors={community} />
        </div>
      </section>
    )
  }

  <section class="border-t py-16" style="border-color: var(--border-subtle);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionTitle title="Se" highlight="Sponsor" />
      <SponsorPackages />
    </div>
  </section>
</Layout>
