---
import { SIGNATORY } from '@lib/certificates/snapshot';

interface Props {
  year: number;
  title: string;
  person: string;
  recognition: string;
  dateLabel: string;
  venueLine: string;
  editable?: boolean;
}

const { year, title, person, recognition, dateLabel, venueLine, editable = false } = Astro.props;
---

<article class="sheet" aria-label={`${title} ${year}`}>
  <aside>
    <p class="mark">JCONF<span>PERÚ</span></p>
    <p class="year">{year}<small>Lima</small></p>
    <p class="meta">{dateLabel}<br />{venueLine}</p>
  </aside>
  <div class="body">
    <p class="kicker">Peru JUG</p>
    <h2>{title}</h2>
    <p class="grant">Se otorga a</p>
    <p class="person" id={editable ? 'certificate-person' : undefined}>{person}</p>
    <div class="rule"></div>
    <p class="prose">{recognition}</p>
    <div class="foot">
      <div>
        <p class="signature">{SIGNATORY.name}</p>
        <p class="sign-role">{SIGNATORY.role}</p>
      </div>
      <p class="verify">Verificación<br />jconfperu.com</p>
    </div>
  </div>
</article>

<style>
  .sheet {
    display: grid;
    grid-template-columns: 168px 1fr;
    min-height: 460px;
    background: white;
    color: #0b0f28;
    border: 1px solid rgba(11, 15, 40, 0.16);
    box-shadow: 0 16px 40px rgba(11, 15, 40, 0.12);
    font-family: Poppins, sans-serif;
  }

  aside {
    position: relative;
    padding: 28px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: white;
    background:
      radial-gradient(1px 1px at 20% 18%, rgba(255, 255, 255, 0.85) 50%, transparent 51%),
      radial-gradient(1px 1px at 70% 30%, rgba(255, 255, 255, 0.7) 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 40% 70%, rgba(255, 255, 255, 0.8) 50%, transparent 51%),
      linear-gradient(180deg, #12183a, #05060f);
  }

  aside::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 7px;
    height: 100%;
    background: #dd0a37;
  }

  .mark {
    margin: 0;
    font-weight: 800;
    letter-spacing: 0.14em;
    font-size: 13px;
  }

  .mark span {
    display: block;
    margin-top: 4px;
    color: #dd0a37;
    letter-spacing: 0.22em;
    font-size: 11px;
  }

  .year {
    margin: 0;
    font-size: 48px;
    font-weight: 800;
    line-height: 0.85;
  }

  .year small {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    letter-spacing: 0.18em;
  }

  .meta {
    margin: 0;
    font-size: 11px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
  }

  .body {
    padding: 32px 36px 24px;
    display: flex;
    flex-direction: column;
  }

  .kicker {
    margin: 0;
    color: #dd0a37;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h2 {
    margin: 8px 0 0;
    font-size: 28px;
    line-height: 1.1;
    color: #0b0f28;
  }

  .grant,
  .sign-role,
  .verify {
    color: #5c6178;
  }

  .grant {
    margin: 22px 0 0;
    font-size: 14px;
  }

  .person {
    margin: 6px 0 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
  }

  .rule {
    width: 120px;
    height: 4px;
    margin-top: 10px;
    background: #dd0a37;
  }

  .prose {
    max-width: 38rem;
    margin: 18px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: end;
    margin-top: auto;
    padding-top: 28px;
  }

  .signature {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .sign-role,
  .verify {
    margin: 4px 0 0;
    font-size: 11px;
  }

  .verify {
    text-align: right;
  }

  @media (max-width: 720px) {
    .sheet {
      grid-template-columns: 1fr;
    }

    aside {
      min-height: 180px;
    }

    aside::after {
      top: auto;
      right: auto;
      bottom: 0;
      width: 100%;
      height: 7px;
    }

    .person,
    h2 {
      font-size: 24px;
    }

    .body {
      padding: 24px 20px;
    }
  }
</style>
