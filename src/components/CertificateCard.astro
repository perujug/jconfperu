---
import { certificateKind, certificateRoleWord } from '@lib/certificates/roles';

interface Props {
  year: number;
  title: string;
  person: string;
  recognition: string;
  dateLabel: string;
  venueLine: string;
  editable?: boolean;
}

const { year, title, person, recognition, dateLabel, venueLine, editable = false } = Astro.props;
const kind = certificateKind(title);
const roleWord = certificateRoleWord(kind);
const rail = kind === 'speaker' || kind === 'organizador' || kind === 'voluntario';
const dated = dateLabel.match(/(\d{1,2})\s+de\s+([a-záéíóúñ]+)/i);
const dayMonth = dated ? `${dated[1]} ${dated[2].toUpperCase()}` : dateLabel;
const place = /lima/i.test(venueLine) ? `${year} · LIMA, PERÚ` : venueLine;
---

<article class:list={['sheet', kind, { rail }]} aria-label={`${roleWord} ${year}`}>
  {
    rail && (
      <aside>
        <p class="rail-role">{roleWord}</p>
        <span class="rail-rule"></span>
        <p class="slogan">Aprende,<br />comparte,<br />conecta.</p>
      </aside>
    )
  }
  <div class="body">
    {rail ? <p class="when">{dayMonth}<br />{place}</p> : <p class="kicker">JConf Perú {year}</p>}
    <h2>Certificado</h2>
    <p class="role">{roleWord}</p>
    <p class="grant">Se otorga el presente certificado a</p>
    <p class="person" id={editable ? 'certificate-person' : undefined}>{person}</p>
    <div class="rule"></div>
    <p class="prose">{recognition}</p>
    <div class="foot">
      <div>
        <p class="signature">PERU JUG</p>
        <p class="sign-role">Peru Java User Group</p>
      </div>
      <p class="verify">Verificación<br />jconfperu.com</p>
    </div>
  </div>
</article>

<style>
  .sheet {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 520px;
    background: white;
    color: #171719;
    border: 1px solid rgba(23, 23, 25, 0.14);
    box-shadow: 0 16px 40px rgba(11, 15, 40, 0.12);
    font-family: Poppins, sans-serif;
    overflow: hidden;
  }

  .sheet.rail {
    grid-template-columns: 232px 1fr;
  }

  aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: 48px 28px;
    color: white;
    background: #171719;
  }

  .slogan {
    margin: 0;
  }

  .rail-rule {
    width: 136px;
    height: 1px;
    background: #656068;
  }

  .rail-role {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0.02em;
  }

  .organizador .rail-role,
  .voluntario .rail-role {
    font-size: 20px;
    letter-spacing: 0.04em;
  }

  .when {
    position: absolute;
    top: 28px;
    right: 28px;
    margin: 0;
    color: #55515a;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.35;
    text-align: right;
    text-transform: uppercase;
  }

  .slogan {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.15;
  }

  .body {
    position: relative;
    padding: 36px 40px 28px;
    display: flex;
    flex-direction: column;
  }

  .rail .body {
    padding-top: 92px;
  }

  .kicker {
    margin: 0;
    color: #5c6178;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    margin: 8px 0 0;
    font-size: 52px;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #171719;
  }

  .role {
    margin: 10px 0 0;
    color: #dd0a37;
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .rail .role {
    color: #6d176f;
    font-size: 26px;
    letter-spacing: 0.12em;
  }

  .grant {
    margin: 28px 0 0;
    color: #5c6178;
    font-size: 15px;
  }

  .person {
    margin: 6px 0 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
  }

  .rule {
    width: 148px;
    height: 4px;
    margin-top: 12px;
    background: #dd0a37;
  }

  .prose {
    max-width: 40rem;
    margin: 18px 0 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: end;
    margin-top: auto;
    padding-top: 32px;
  }

  .signature {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .sign-role,
  .verify {
    margin: 4px 0 0;
    color: #5c6178;
    font-size: 13px;
  }

  .verify {
    text-align: right;
  }

  .sheet:not(.rail) .body {
    border-bottom: 28px solid #171719;
  }

  @media (max-width: 720px) {
    .sheet.rail {
      grid-template-columns: 1fr;
    }

    .when {
      position: static;
      margin-bottom: 16px;
      text-align: left;
    }

    aside {
      min-height: 220px;
    }

    h2 {
      font-size: 40px;
    }

    .role,
    .rail-role {
      font-size: 28px;
    }

    .person {
      font-size: 26px;
    }

    .body {
      padding: 24px 20px;
    }
  }
</style>
