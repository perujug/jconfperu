---
interface Props {
  href: string;
  name: string;
  kind: 'facebook' | 'twitter' | 'linkedin' | 'whatsapp' | 'meetup' | 'github' | 'youtube' | 'website';
}

const { href, name, kind } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={name}
  title={name}
  class="inline-flex h-9 w-9 items-center justify-center rounded-full border transition-colors hover:bg-java-orange hover:text-white hover:border-java-orange"
  style="border-color: var(--border-subtle);"
>
  {
    kind === 'facebook' && (
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.14 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.8 8.43-4.94 8.43-9.94z" />
      </svg>
    )
  }
  {
    kind === 'twitter' && (
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.16 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
    )
  }
  {
    kind === 'linkedin' && (
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM8 19H5V8h3v11zM6.5 6.73c-.97 0-1.75-.79-1.75-1.75S5.53 3.23 6.5 3.23s1.75.79 1.75 1.75S7.47 6.73 6.5 6.73zM20 19h-3v-5.6c0-1.34-.03-3.06-1.86-3.06-1.86 0-2.14 1.45-2.14 2.96V19h-3V8h2.88v1.5h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.59V19z" />
      </svg>
    )
  }
  {
    kind === 'whatsapp' && (
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d="M20.52 3.48A11.86 11.86 0 0012.04 0C5.5 0 .19 5.3.18 11.83c0 2.08.55 4.12 1.6 5.91L0 24l6.4-1.68a11.86 11.86 0 005.64 1.43h.01c6.54 0 11.85-5.3 11.86-11.83a11.74 11.74 0 00-3.39-8.44zM12.05 21.7h-.01a9.83 9.83 0 01-5.01-1.37l-.36-.21-3.79 1 1.01-3.7-.23-.38a9.78 9.78 0 01-1.5-5.21c0-5.42 4.43-9.83 9.88-9.83a9.84 9.84 0 016.99 2.88 9.71 9.71 0 012.88 6.95c0 5.42-4.43 9.83-9.86 9.83zm5.41-7.36c-.3-.15-1.76-.86-2.03-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.34.45-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.91-2.18-.24-.57-.48-.5-.66-.51l-.56-.01a1.08 1.08 0 00-.78.36c-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.88 1.21 3.08.15.2 2.1 3.2 5.07 4.49.71.31 1.26.5 1.69.64.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z" />
      </svg>
    )
  }
  {
    kind === 'meetup' && (
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d="M22.6 17.51l-2.58-1.21c-.55-.25-.79-.91-.54-1.46l1.07-2.32a4.13 4.13 0 00-2.25-5.6l-1.4-.55a4.13 4.13 0 00-5.32 2.25l-1.78 4.51c-.4 1-.84 1.84-1.7 2.5l-2.6 2c-1.05.81-2.46.74-3.4-.16-1.1-1.05-1.1-2.84 0-3.89l1.99-1.9c.65-.62.71-1.65.13-2.34l-1.5-1.78a1.59 1.59 0 11.18-2.21L4 6.7a4.13 4.13 0 005.92-.65l2.46-3.13a4.13 4.13 0 015.83-.71l1.32 1.05a4.13 4.13 0 011.63 4.21l-.32 1.69c-.13.7.25 1.4.91 1.66l2.85 1.13c.85.34 1.27 1.31.95 2.16l-1.94 4.99a1.61 1.61 0 01-2.04.96l-1.99-.55z" />
      </svg>
    )
