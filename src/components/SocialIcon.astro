---
interface Props {
  href: string;
  name: string;
  kind: 'facebook' | 'twitter' | 'linkedin' | 'whatsapp' | 'meetup' | 'github' | 'youtube' | 'website' | 'google';
}

const { href, name, kind } = Astro.props;

const icons: Record<Props['kind'], string> = {
  facebook: 'fa-facebook',
  twitter: 'fa-twitter',
  linkedin: 'fa-linkedin',
  whatsapp: 'fa-whatsapp',
  meetup: 'fa-users',
  github: 'fa-github',
  youtube: 'fa-youtube-play',
  website: 'fa-globe',
  google: 'fa-google-plus',
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={name}
  title={name}
  class="contact-social-link"
>
  <i class:list={['fa', icons[kind]]} aria-hidden="true"></i>
</a>
