---
import type { CollectionEntry } from 'astro:content';
import Countdown from '@components/Countdown.astro';

interface Props {
  edition: CollectionEntry<'editions'>;
}

const { edition } = Astro.props;
const { data } = edition;

const formattedDate =
  data.date != null
    ? new Intl.DateTimeFormat('es-PE', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      }).format(data.date)
    : null;

const dateLabel = formattedDate
  ? data.dateLabel
    ? `${formattedDate} · ${data.dateLabel}`
    : formattedDate
  : (data.dateLabel ?? 'Fecha por anunciar');

const locationLabel = data.venue?.online
  ? `Online · ${data.venue.country}`
  : [data.venue?.address, data.venue?.name, data.venue?.city, data.venue?.country]
      .filter(Boolean)
      .join(' · ');

const mapsHref = data.venue?.mapsQuery
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(data.venue.mapsQuery)}`
  : undefined;
---

<section class="relative overflow-hidden text-white bg-starfield" aria-labelledby="hero-title">
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-20 sm:py-28 grid gap-6 text-center justify-items-center">
    <h1
      id="hero-title"
      class="font-display text-4xl sm:text-6xl font-black uppercase tracking-wide leading-tight text-white"
    >
      {data.title}
    </h1>

    <p class="text-base sm:text-xl uppercase tracking-wide text-white">
      {data.tagline}
    </p>

    {
      data.date && (
        <p class="text-xl sm:text-3xl font-bold uppercase text-white">{dateLabel}</p>
      )
    }

    <Countdown target={data.date} placeholder={data.date ? '¡Evento en curso!' : dateLabel} />

    {
      locationLabel && (
        <div class="event-location-bar">
          <i class="fa fa-map-marker" aria-hidden="true"></i>
          {
            mapsHref ? (
              <a href={mapsHref} target="_blank" rel="noopener noreferrer">
                {locationLabel}
              </a>
            ) : (
              <span>{locationLabel}</span>
            )
          }
        </div>
      )
    }

    {
      data.cta && (
        <div class="mt-2">
          <a
            href={data.cta.href}
            class:list={['main-btn', data.cta.disabled && 'is-disabled']}
            aria-disabled={data.cta.disabled ? 'true' : undefined}
          >
            {data.cta.label}
          </a>
          {data.cta.note && <p class="text-sm text-white/80 mt-3">{data.cta.note}</p>}
        </div>
      )
    }
  </div>
</section>
