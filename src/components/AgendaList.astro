---
interface AgendaSession {
  id: string;
  data: {
    order: number;
    startTime: string;
    endTime: string;
    room?: string | null;
    title: string;
    delivery?: string | null;
    liveUrl?: string | null;
    speakerNames?: string[];
    speakerProfiles?: { name: string; url?: string | null }[];
    youtubeUrl?: string | null;
    facebookUrl?: string | null;
    linkedinUrl?: string | null;
  };
}

interface Props {
  sessions: AgendaSession[];
}

const { sessions } = Astro.props;

const sorted = [...sessions].sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.data.startTime.localeCompare(b.data.startTime),
);

function groupByTime(items: AgendaSession[]) {
  const map = new Map<string, AgendaSession[]>();
  for (const s of items) {
    const key = `${s.data.startTime} – ${s.data.endTime}`;
    const list = map.get(key) ?? [];
    list.push(s);
    map.set(key, list);
  }
  return Array.from(map.entries());
}

const grouped = groupByTime(sorted);
---

<ol class="grid gap-5">
  {
    grouped.map(([slot, items]) => (
      <li
        class="rounded-card border bg-[color:var(--bg-elevated)] p-5 shadow-sm"
        style="border-color: var(--border-subtle);"
      >
        <p class="text-sm font-bold uppercase tracking-wide" style="color: var(--accent-text);">
          <i class="fa fa-clock-o" aria-hidden="true"></i> {slot} (GMT-5)
        </p>
        <div class="grid gap-4 mt-3 md:grid-cols-2">
          {items.map((s) => (
            <article
              class="border-l-2 pl-4 py-1"
              style={`border-color: ${s.data.delivery === 'online' ? '#0f6f8a' : 'var(--border-subtle)'};`}
            >
              {s.data.room && (
                <p class="text-xs uppercase tracking-wide" style="color: var(--fg-muted);">
                  {s.data.room}
                </p>
              )}
              {(s.data.delivery === 'online' || s.data.delivery === 'ambas') && (
                <p class="mt-1 text-xs font-bold uppercase tracking-wide" style="color: #0f6f8a;">
                  <i class="fa fa-video-camera" aria-hidden="true"></i>{' '}
                  {s.data.delivery === 'online' ? 'Online' : 'También online'}
                </p>
              )}
              <h3 class="font-display text-lg font-bold mt-0.5">{s.data.title}</h3>
              {(s.data.speakerProfiles?.length || s.data.speakerNames?.length) && (
                <p class="text-sm mt-1" style="color: var(--fg-muted);">
                  Por{' '}
                  {s.data.speakerProfiles?.length ? (
                    s.data.speakerProfiles.map((p, i) => (
                      <>
                        {i > 0 && ', '}
                        {p.url ? (
                          <a class="underline hover-brand-red" href={p.url} target="_blank" rel="noopener noreferrer">
                            {p.name}
                          </a>
                        ) : (
                          p.name
                        )}
                      </>
                    ))
                  ) : (
                    (s.data.speakerNames ?? []).join(', ')
                  )}
                </p>
              )}
              {s.data.liveUrl && (s.data.delivery === 'online' || s.data.delivery === 'ambas') && (
                <p class="mt-2 text-sm">
                  <a class="font-bold hover:underline" style="color: #0f6f8a;" href={s.data.liveUrl} target="_blank" rel="noopener noreferrer">
                    Ver en Riverside
                  </a>
                </p>
              )}
              {(s.data.youtubeUrl || s.data.facebookUrl || s.data.linkedinUrl) && (
                <div class="flex gap-2 mt-2 text-xs">
                  {s.data.youtubeUrl && (
                    <a
                      class="inline-flex items-center gap-1 text-brand-red hover:underline"
                      href={s.data.youtubeUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ▶ YouTube
                    </a>
                  )}
                  {s.data.facebookUrl && (
                    <a
                      class="inline-flex items-center gap-1 text-facebook hover:underline"
                      href={s.data.facebookUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ▶ Facebook
                    </a>
                  )}
                  {s.data.linkedinUrl && (
                    <a
                      class="inline-flex items-center gap-1 text-linkedin hover:underline"
                      href={s.data.linkedinUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ▶ LinkedIn
                    </a>
                  )}
                </div>
              )}
            </article>
          ))}
        </div>
      </li>
    ))
  }
</ol>
