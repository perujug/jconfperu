---
interface Props {
  stats?: {
    hours?: number;
    sessions?: number;
    countries?: number;
    speakers?: number;
  };
}

const { stats } = Astro.props;
const items = [
  { value: stats?.hours, label: 'Horas' },
  { value: stats?.sessions, label: 'Sesiones' },
  { value: stats?.countries, label: 'Países' },
  { value: stats?.speakers, label: 'Speakers' },
].filter((i) => typeof i.value === 'number');
---

{
  items.length > 0 && (
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-10">
      {items.map((i) => (
        <div
          class="text-center rounded-card border py-6 bg-[color:var(--bg-elevated)]"
          style="border-color: var(--border-subtle);"
        >
          <p class="font-display text-3xl sm:text-4xl font-extrabold text-brand-accent">
            {i.value}+
          </p>
          <p class="uppercase tracking-wide text-xs mt-1" style="color: var(--fg-muted);">
            {i.label}
          </p>
        </div>
      ))}
    </div>
  )
}
