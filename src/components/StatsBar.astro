---
interface Props {
  stats?: {
    hours?: number;
    sessions?: number;
    countries?: number;
    speakers?: number;
  };
}

const { stats } = Astro.props;
const items = [
  { value: stats?.hours, label: 'Horas' },
  { value: stats?.sessions, label: 'Sesiones' },
  { value: stats?.countries, label: 'Países' },
  { value: stats?.speakers, label: 'Conferencistas' },
].filter((item) => typeof item.value === 'number' && item.value > 0);
---

{
  items.length > 0 && (
    <div
      id="numbers"
      class:list={[
        'grid gap-6 mt-14 mb-4 text-center',
        items.length >= 4
          ? 'grid-cols-2 sm:grid-cols-4'
          : items.length === 1
            ? 'grid-cols-1 max-w-xs mx-auto'
            : 'grid-cols-2',
      ]}
    >
      {items.map((item) => (
        <div>
          <p class="font-display text-5xl font-bold leading-none" style="color: #dd0a37;">
            {item.value}+
          </p>
          <p class="mt-2 uppercase tracking-wide text-sm" style="color: var(--fg-strong);">
            {item.label}
          </p>
        </div>
      ))}
    </div>
  )
}
