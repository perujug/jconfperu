---
interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, highlight, align = 'center' } = Astro.props;
const alignment = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<header class:list={['max-w-3xl mb-10', alignment]}>
  {
    eyebrow && (
      <p class="uppercase tracking-[0.3em] text-xs font-semibold text-java-orange mb-3">
        {eyebrow}
      </p>
    )
  }
  <h2 class="font-display text-3xl sm:text-4xl font-bold leading-tight">
    {title}{' '}
    {highlight && <span class="text-peru-red">{highlight}</span>}
  </h2>
</header>
