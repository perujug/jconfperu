---
interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, highlight, align = 'center' } = Astro.props;
const alignment = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<header class:list={['section-title max-w-3xl mb-10', alignment]}>
  {
    eyebrow && (
      <p class="uppercase tracking-[0.2em] text-xs font-bold mb-3" style="color: var(--fg-strong);">
        {eyebrow}
      </p>
    )
  }
  <h2 class="font-display text-4xl sm:text-[42px] font-black leading-tight capitalize" style="color: var(--fg-strong);">
    {title}{' '}
    {highlight && <span style="color: #dd0a37;">{highlight}</span>}
  </h2>
</header>
