---
import { Image } from 'astro:assets';
import logo from '@/assets/images/perujug/logo-2024.png';
import { SITE, SOCIAL } from '@lib/site';
import SocialIcon from '@components/SocialIcon.astro';

const year = new Date().getFullYear();
---

<footer id="footer" class="py-14" style="background: var(--bg-base);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 grid gap-10 md:grid-cols-3 items-center">
    <div class="text-center md:text-left text-sm" style="color: var(--fg-base);">
      <p>Copyright © {year} All rights reserved</p>
      <p class="mt-4 text-xs">
        This template is made with <i class="fa fa-heart-o" aria-hidden="true"></i> by
        <a class="contact-link" href="https://colorlib.com" target="_blank" rel="noopener noreferrer">Colorlib</a>
      </p>
    </div>

    <div class="flex flex-col items-center gap-3">
      <a href="/" aria-label={`Inicio · ${SITE.name}`}>
        <Image src={logo} alt="" width={180} height={180} class="h-32 w-auto" loading="lazy" />
      </a>
      <p class="font-bold" style="color: var(--fg-strong);">{SITE.organization}</p>
    </div>

    <div class="contact-social flex flex-wrap justify-center md:justify-end gap-4">
      <SocialIcon href={SOCIAL.facebook} name="Facebook" kind="facebook" />
      <SocialIcon href={SOCIAL.twitter} name="Twitter" kind="twitter" />
      <SocialIcon href={SOCIAL.google} name="Google Group" kind="google" />
      <SocialIcon href={SOCIAL.linkedin} name="LinkedIn" kind="linkedin" />
      <SocialIcon href={SOCIAL.whatsapp} name="WhatsApp" kind="whatsapp" />
    </div>
  </div>
</footer>
