---
import { sessionizeEmbedSrc, type SessionizeView } from '@lib/sessionize';

interface Props {
  eventId: string;
  view: SessionizeView;
}

const { eventId, view } = Astro.props;
const src = sessionizeEmbedSrc(eventId, view);

let html: string | null = null;
try {
  const response = await fetch(src, {
    headers: {
      accept: 'text/html, text/javascript, application/javascript',
      'user-agent': 'jconfperu-build (+https://jconfperu.com)',
    },
  });
  if (response.ok) {
    const contentType = response.headers.get('content-type') ?? '';
    const body = await response.text();
    if (contentType.includes('html') || body.trimStart().startsWith('<')) {
      html = body;
    }
  } else {
    console.warn(`[sessionize] ${src} respondió ${response.status}`);
  }
} catch (error) {
  console.warn('[sessionize] error consultando', src, error);
}
---

<div data-sessionize-embed>
  {
    html ? (
      <Fragment set:html={html} />
    ) : (
      <script is:inline type="text/javascript" src={src}></script>
    )
  }
</div>
