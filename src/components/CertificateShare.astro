---
import { certificateShareDraft } from '@lib/certificates/release';

interface Props {
  year: number;
  title: string;
  url: string;
}

const { year, title, url } = Astro.props;
const draft = certificateShareDraft(year, title, url);
---

<form class="mt-8 grid max-w-xl gap-3" data-certificate-share>
  <label class="grid gap-1">
    <span class="font-bold">Texto para LinkedIn</span>
    <textarea class="border px-3 py-2" style="border-color: var(--border-subtle);" name="text" rows="6">{draft}</textarea>
  </label>
  <p class="text-sm" style="color: var(--fg-muted);">Puedes cambiarlo antes de publicar. En LinkedIn también se puede seguir editando.</p>
  <button class="main-btn justify-self-start" type="submit">Compartir en LinkedIn</button>
</form>

<script>
  document.querySelectorAll('form[data-certificate-share]').forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === '1') return;
    form.dataset.bound = '1';
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const text = String(new FormData(form).get('text') ?? '').trim();
      const href = `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(text)}`;
      window.open(href, '_blank', 'noopener');
    });
  });
</script>
