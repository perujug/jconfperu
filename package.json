{
  "name": "jconfperu",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio web de JConf Perú — la conferencia anual de Java organizada por Peru JUG.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "generate:assets": "node scripts/generate-social-assets.mjs",
    "build": "npm run generate:assets && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "validate:site": "node scripts/validate-built-site.mjs",
    "test:site": "playwright test",
    "test": "npm run audit && npm run check && npm run build && npm run validate:site && npm run test:site",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/perujug/jconfperu.git"
  },
  "keywords": [
    "java",
    "conference",
    "peru",
    "perujug",
    "jconf",
    "astro"
  ],
  "author": "Peru JUG",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "sharp": "0.35.5"
  }
}
